{
  "name": "dsh-trajectory-persistence",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) plugin: persist session trajectories to S3/OSS (JSONL) and OTel GenAI spans (OTLP).",
  "keywords": [
    "deepseek",
    "dsh",
    "cordis",
    "opentelemetry",
    "otel",
    "otlp",
    "genai",
    "s3",
    "oss",
    "observability",
    "tracing",
    "trajectories",
    "jsonl",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aws-cnug-o11y/dsh-trajectory-persistence.git"
  },
  "homepage": "https://github.com/aws-cnug-o11y/dsh-trajectory-persistence#readme",
  "bugs": "https://github.com/aws-cnug-o11y/dsh-trajectory-persistence/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-trajectory-persistence": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync-down": "node lib/cli.js sync-down",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "pnpm build && pnpm test",
    "prepare": "tsc -p tsconfig.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.1112.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/otlp-transformer": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@smithy/core": "^3.33.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Tian Deng",
  "publishConfig": {
    "access": "public"
  }
}
