{
  "name": "dsh-trajectory-persistence",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) plugin: persist session trajectories to S3/OSS (JSONL) and OTel GenAI spans (OTLP).",
  "keywords": [
    "deepseek",
    "dsh",
    "cordis",
    "opentelemetry",
    "otel",
    "otlp",
    "genai",
    "s3",
    "oss",
    "observability",
    "tracing",
    "trajectories",
    "jsonl",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tiandeng/dsh-trajectory-persistence.git"
  },
  "homepage": "https://github.com/tiandeng/dsh-trajectory-persistence#readme",
  "bugs": "https://github.com/tiandeng/dsh-trajectory-persistence/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
